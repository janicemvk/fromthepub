# Safe Uniswap Trading Bot Environment Configuration
# Copy this file to .env and fill in your actual values

# ⚠️  SECURITY WARNING: Never commit .env files to version control!

# Network Configuration
RPC_URL=https://eth-mainnet.alchemyapi.io/v2/YOUR_ALCHEMY_API_KEY
PRIVATE_KEY=your_private_key_here_WITHOUT_0x_prefix
CONTRACT_ADDRESS=your_deployed_contract_address_here

# Alternative RPC Providers (choose one)
# RPC_URL=https://mainnet.infura.io/v3/YOUR_INFURA_KEY
# RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# Environment Settings
NODE_ENV=development  # development, staging, production

# Optional: Testnet Configuration (for staging)
TESTNET_RPC_URL=https://goerli.infura.io/v3/YOUR_INFURA_KEY
TESTNET_PRIVATE_KEY=your_testnet_private_key_here
TESTNET_CONTRACT_ADDRESS=your_testnet_contract_address

# Optional: Advanced Settings
LOG_LEVEL=info        # debug, info, warn, error
MAX_GAS_PRICE=50      # Maximum gas price in gwei
TRADE_AMOUNT=0.01     # Default trade amount in ETH

# ⚠️  IMPORTANT SAFETY REMINDERS:
# 1. Start with simulateOnly: true in config.js
# 2. Test on testnets before mainnet
# 3. Use small amounts initially
# 4. Never share your private keys
# 5. This is for educational purposes only!